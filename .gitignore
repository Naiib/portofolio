Thumbs.db

# secrets and certs
*.pem
*.key
*.crt

# logs
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*
*.log

# package manager caches
.npm/
.pnpm-store/

# optional: keep static assets like public/profile and public/projects tracked
